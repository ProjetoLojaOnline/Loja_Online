#!/bin/sh
# Executado automaticamente antes de cada git push.
# Para configurar: make setup-hooks

# ── 1. Formatação (Spotless) ──────────────────────────────────────────────────
printf "🔍 Verificando formatação do código...\n"
FORMAT_OUTPUT=$(./mvnw spotless:check --no-transfer-progress 2>&1)
FORMAT_EXIT=$?

if [ $FORMAT_EXIT -ne 0 ]; then
  printf "\n❌ ERRO: código com formatação incorreta.\n"
  printf "   Arquivos com problema:\n"
  echo "$FORMAT_OUTPUT" | grep -E "patch needed|\.java" | sed 's/^/   /'
  printf "\n   ✏️  Solução: rode  make lint  e faça commit das correções.\n\n"
  exit 1
fi
printf "✅ Formatação OK.\n"

# ── 2. Padrão de código (Checkstyle) ─────────────────────────────────────────
printf "🔍 Verificando padrão de código (Checkstyle)...\n"
STYLE_OUTPUT=$(./mvnw checkstyle:check --no-transfer-progress 2>&1)
STYLE_EXIT=$?

if [ $STYLE_EXIT -ne 0 ]; then
  printf "\n❌ ERRO: violações de estilo encontradas.\n"
  printf "   Detalhes:\n"
  echo "$STYLE_OUTPUT" | grep "\[ERROR\].*\.java" | sed 's/\[ERROR\] //' | sed 's/^/   /'
  printf "\n   ⚠️  Spotless não corrige esses erros automaticamente.\n"
  printf "       Corrija manualmente e rode  make lint  para verificar.\n\n"
  exit 1
fi
printf "✅ Checkstyle OK.\n"

# ── 3. Testes unitários (sem Docker) ─────────────────────────────────────────
printf "🔍 Rodando testes unitários...\n"
UNIT_OUTPUT=$(./mvnw test --no-transfer-progress 2>&1)
UNIT_EXIT=$?

if [ $UNIT_EXIT -ne 0 ]; then
  printf "\n❌ ERRO: testes unitários falharam. Push bloqueado.\n"
  printf "   Falhas encontradas:\n"
  echo "$UNIT_OUTPUT" | grep -E "FAILED|ERROR|Tests run:" | grep -v "Tests run: 0" | sed 's/^/   /'
  printf "\n   Corrija os testes e tente novamente.\n\n"
  exit 1
fi
printf "✅ Testes unitários OK.\n"

# ── 4. Testes de integração (Testcontainers — requer Docker) ─────────────────
printf "🔍 Rodando testes de integração (Testcontainers)...\n"
IT_OUTPUT=$(./mvnw failsafe:integration-test failsafe:verify --no-transfer-progress 2>&1)
IT_EXIT=$?

if [ $IT_EXIT -ne 0 ]; then
  printf "\n❌ ERRO: testes de integração falharam. Push bloqueado.\n"
  printf "   Falhas encontradas:\n"
  echo "$IT_OUTPUT" | grep -E "FAILED|ERROR|Tests run:" | grep -v "Tests run: 0" | sed 's/^/   /'
  printf "\n   Corrija os testes e tente novamente.\n\n"
  exit 1
fi
printf "✅ Testes de integração OK.\n\n"
printf "🚀 Push autorizado!\n"
